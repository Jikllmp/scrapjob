{
  "name": "scrapjob",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green --kill-others-on-fail \"pnpm --filter @scrapjob/api dev\" \"pnpm --filter @scrapjob/web dev\"",
    "demo": "concurrently --names api,web --prefix-colors blue,green --kill-others-on-fail \"pnpm --filter @scrapjob/api demo\" \"pnpm --filter @scrapjob/web dev\"",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @scrapjob/api db:generate",
    "registry:import": "pnpm --filter @scrapjob/api registry:import",
    "data:purge": "pnpm --filter @scrapjob/api data:purge",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "concurrently": "^9.2.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
