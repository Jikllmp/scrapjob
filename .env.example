# Copy to .env and fill in. Every key is optional; missing API keys disable
# their source instead of blocking startup. Never commit .env.

# --- Server ---
# Port of the API. The web dev server (http://localhost:5173) proxies /api to it.
PORT=3001
# SQLite file, relative to the repository root. Created on first start.
DATABASE_URL=file:./data/scrapjob.db
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Identity of the crawler ---
# A page that explains who runs this bot and how to reach you. Sent in the
# User-Agent of every outbound request. Required before the first live search.
USER_AGENT_CONTACT_URL=

# --- Search API ---
# Brave Search API key (https://brave.com/search/api/). Leave blank to disable web search.
BRAVE_API_KEY=

# --- Search limits ---
# Upper bound for the number of contacts a search may target.
MAX_CONTACTS_PER_SEARCH=20
# Contacts scoring below this (0-100) are rejected.
MIN_RELEVANCE_SCORE=35
# A search stops after this many milliseconds (10 minutes).
MAX_SEARCH_DURATION_MS=600000
# A search stops after this many outbound HTTP requests.
MAX_HTTP_REQUESTS=300
# A search stops after this many search-API calls.
MAX_SEARCH_API_CALLS=40
# Outbound requests allowed for one deep search.
MAX_DEEP_SEARCH_REQUESTS=25

# --- Politeness and resilience ---
# Global cap on concurrent outbound requests.
MAX_CONCURRENT_REQUESTS=4
# Requests per second allowed to any single host.
PER_HOST_RPS=1
# Timeout for every outbound request, in milliseconds.
REQUEST_TIMEOUT_MS=15000
# Retries on timeouts and 5xx only.
RETRY_COUNT=3
# A source that fails this many times in one search is disabled for that search.
SOURCE_FAILURE_THRESHOLD=3

# --- Sources ---
# Comma-separated adapter ids. Phase 1 ships only "noop", which finds nothing.
ENABLED_SOURCES=noop
# Headless browser fetching. Off by default and not used in Phase 1.
ENABLE_HEADLESS=false

# --- Privacy ---
# Contacts older than this are deleted automatically.
DATA_RETENTION_DAYS=180
# Where generated spreadsheets are written, relative to the repository root.
EXPORT_DIR=./exports
